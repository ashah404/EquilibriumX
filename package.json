{
  "name": "equilibrium-x",
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k \"npm run dev\" \"wait-on tcp:5173 && npm run electron:start\"",
    "electron:start": "cross-env NODE_ENV=development electron .",
    "build": "vite build",
    "pack:desktop": "npm run build && electron-builder"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "vite": "^5.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.ashah404.equilibriumx",
    "productName": "Equilibrium X",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Equilibrium X"
    }
  }
}
